[Unit]
Description=WolfArena FastAPI (nine-player werewolf demo)
After=network.target

[Service]
Type=simple
WorkingDirectory=/www/wwwroot/wolfarena
Environment="PYTHONUNBUFFERED=1"
EnvironmentFile=-/www/wwwroot/wolfarena/.env
ExecStart=/www/wwwroot/wolfarena/.venv/bin/python -m uvicorn backend.api:app \
  --host 127.0.0.1 --port 8001 --proxy-headers
Restart=always
RestartSec=3
User=www
Group=www
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
