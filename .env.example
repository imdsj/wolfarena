# 复制此文件为 .env，然后填写真实值。不要把 .env 提交到 Git。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_SECONDS=8

# 兼容旧配置，优先级低于 DEEPSEEK_* 变量
OPENAI_API_KEY=
MODEL_NAME=
DATABASE_URL=

# 策略实验室人工审批的共享密钥：通过/驳回/回滚必须带 X-Reviewer-Token。
# 请改成一段随机长字符串，不要提交真实值。
WOLFARENA_REVIEWER_TOKEN=
